# Backend server origin. The documented API paths already include /api.
# Same-origin Next.js proxy. The server-side destination is BACKEND_ORIGIN below.
NEXT_PUBLIC_API_BASE_URL=/backend

# Deployed Spring backend origin used by the Next.js rewrite.
BACKEND_ORIGIN=https://hackathonback.devdlfjstizlzl.xyz

# Passport card UID seeded by the backend reference-data initializer.
NEXT_PUBLIC_PASSPORT_CARD_UID=MCM-GUIDE-TEST-001

# Product ID obtained from the QR/NFC product tag in a real integration.
NEXT_PUBLIC_DEMO_PRODUCT_ID=1

# The two physical bag stickers written from /nfc-setup.
NEXT_PUBLIC_NFC_BAG_1_PRODUCT_ID=1
NEXT_PUBLIC_NFC_BAG_1_CODE=STARK_BACKPACK
NEXT_PUBLIC_NFC_BAG_1_NAME=Stark Backpack
NEXT_PUBLIC_NFC_BAG_2_PRODUCT_ID=2
NEXT_PUBLIC_NFC_BAG_2_CODE=AREN_SHOPPER
NEXT_PUBLIC_NFC_BAG_2_NAME=Aren Shopper
